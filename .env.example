# Browser configuration: Firebase console > Project settings > Your apps > Web app.
# Only these public values get the VITE_ prefix. Changes require a new Netlify build.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# Server only: set in Netlify environment variables (Functions scope).
APP_BASE_URL=https://healthycashsh.netlify.app
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste a PEM key, or a quoted value with literal \n between lines. Never commit the real key.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
KAKAO_REST_API_KEY=
# Required when client-secret verification is enabled in the Kakao console.
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Local Firebase emulator testing only, never on Netlify production.
# VITE_USE_FIREBASE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NETLIFY_DEV=true
# APP_BASE_URL=http://localhost:8888
